; 启幕客户端 · 独立 Windows 安装包 (NSIS) —— 第一期分开打包 (2026-11-23)
; 与服务器安装包 (启幕-服务器.nsi) 完全独立: 各自安装目录、各自卸载项,
; 互不捆绑, 可单独安装/升级/卸载。客户端通过「设置 → 服务器」填写
; 服务器地址连接任意一台启幕服务器 (含局域网自动发现)。
; 构建 (Linux): cp 启幕-客户端.nsi qimu-client-setup.nsi && LC_ALL=C.UTF-8 makensis qimu-client-setup.nsi
;   - 中文脚本文件名会让 makensis 的 argv 转换失败, 故先拷成 ASCII 名再构建;
;     产物名仍由 OutFile 决定。
;   - SetCompressor 用普通 lzma: /SOLID lzma 在 makensis 3.09 上 SIGBUS (旧包教训)。
; 产物: 启幕客户端-Setup.exe
; 二进制来源: win\ 子目录 (windows-gnu release 构建的 qimu-client.exe + qimu.exe + 使用说明)

Unicode true
SetCompressor lzma

!include "MUI2.nsh"
!include "LogicLib.nsh"

Name "启幕客户端"
OutFile "启幕客户端-Setup.exe"
; 默认走系统 Program Files; .onInit 在 D 盘存在时改到 D:\Program Files\启幕客户端
InstallDir "$PROGRAMFILES64\启幕客户端"
InstallDirRegKey HKLM "Software\QimuClient" "InstallDir"
RequestExecutionLevel admin

!define PRODUCT "启幕客户端"
!define VERSION "0.1.0"
!define PUBLISHER "启幕"
; Installer + uninstaller window icon (brand logo, generated by CI
; from crates/qimu-client/assets/logo.png.b64 — see build-windows.yml).
!define MUI_ICON "qimu.ico"
!define MUI_UNICON "qimu.ico"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "SimpChinese"

; ── 安装时「软件正在运行」处理 (用户 2026-11-25) ──────────────────
; 背景: 覆盖安装时若 qimu-client.exe 正在运行, File 指令直接报错、
; 安装半途失败。本段在写任何文件之前 (.onInit 与安装段开头各查
; 一次, 后者防用户在向导期间又把软件打开) 检测进程: 在运行 →
; 弹框问是否关闭 → 选是先温和关闭、复检仍在再强杀、再复检;
; 选否或杀不掉 → Abort, 此时未写任何文件, 不留半装状态。
; 检测手段: nsExec 跑 tasklist 按映像名过滤、管道给 find, 以 find
; 退出码判定 (0 = 在运行)。nsExec 是 NSIS 官方发行自带插件 (与
; 本脚本已在用的 MUI2/LogicLib 同源, CI 的 apt nsis 包内齐备),
; 且执行外部命令不弹控制台窗口。判定不解析 tasklist 输出文本,
; 不受系统语言影响。没在运行时只多跑两次 tasklist (百毫秒级、
; 无 Sleep), 零感知。tasklist/find 均为 System32 常驻工具。
; 检测对象含 qimu.exe (CLI): 它与主程序同装同目录、同被 File
; 覆盖, 在运行 (长命令/计划任务) 时同样会锁文件导致 File 失败。
; 只用 $R 寄存器, 不碰 .onInit 既有的 $0。$R8 = 检测结果。
Function QimuDetectRunning
  StrCpy $R8 0
  nsExec::Exec '"$SYSDIR\cmd.exe" /C tasklist /FI "IMAGENAME eq qimu-client.exe" /NH | find /I "qimu-client.exe" > NUL'
  Pop $R0
  ${If} $R0 == "0"
    StrCpy $R8 1
    Return
  ${EndIf}
  nsExec::Exec '"$SYSDIR\cmd.exe" /C tasklist /FI "IMAGENAME eq qimu.exe" /NH | find /I "qimu.exe" > NUL'
  Pop $R0
  ${If} $R0 == "0"
    StrCpy $R8 1
  ${EndIf}
FunctionEnd

Function QimuEnsureClosed
  Call QimuDetectRunning
  ${If} $R8 == 0
    Return
  ${EndIf}
  MessageBox MB_YESNO|MB_ICONQUESTION "检测到启幕正在运行，需要先关闭才能继续安装。$\r$\n$\r$\n是否立即关闭并继续安装？选「否」将取消安装。" IDYES QimuCloseYes
  Abort
  QimuCloseYes:
  ; 温和关闭: taskkill 不带 /F 对 GUI 程序发 WM_CLOSE 关闭消息,
  ; 客户端可走正常退出路径; qimu.exe 是控制台程序、无窗口, 此步
  ; 对它无效, 靠下面的强杀兜底 (用户已在弹框中同意关闭)。
  nsExec::Exec '"$SYSDIR\taskkill.exe" /IM qimu-client.exe'
  Pop $R0
  nsExec::Exec '"$SYSDIR\taskkill.exe" /IM qimu.exe'
  Pop $R0
  Sleep 2000
  Call QimuDetectRunning
  ${If} $R8 == 0
    Return
  ${EndIf}
  ; 温和关闭未生效 → 强杀后最后复检
  nsExec::Exec '"$SYSDIR\taskkill.exe" /F /IM qimu-client.exe'
  Pop $R0
  nsExec::Exec '"$SYSDIR\taskkill.exe" /F /IM qimu.exe'
  Pop $R0
  Sleep 1000
  Call QimuDetectRunning
  ${If} $R8 == 0
    Return
  ${EndIf}
  MessageBox MB_OK|MB_ICONEXCLAMATION "无法自动关闭启幕，请手动关闭启幕后，重新运行安装程序。"
  Abort
FunctionEnd

Function .onInit
  ; 软件正在运行 → 先提示关闭 (见上方 QimuEnsureClosed); 选否即
  ; 在此 Abort, 向导都不会打开, 更不写任何文件。
  Call QimuEnsureClosed
  ; 审计 X1: 已装过 (注册表有 InstallDir) 时绝不改道 —— 旧逻辑只要
  ; D 盘存在就无条件改目录, 升级装进新目录后客户端找不到旧库。
  ; D 盘默认只对全新安装生效。
  ReadRegStr $0 HKLM "Software\QimuClient" "InstallDir"
  ${If} $0 != ""
    StrCpy $INSTDIR $0
  ${ElseIf} ${FileExists} "D:\*.*"
    StrCpy $INSTDIR "D:\Program Files\启幕客户端"
  ${EndIf}
FunctionEnd

Section "启幕客户端" SEC_CLIENT
  SectionIn RO
  ; 写文件前最后复检一次: 防向导期间软件又被打开 (.onInit 已查过,
  ; 没在运行时这里只是百毫秒级静默通过)。仍在运行且关不掉/选否 →
  ; Abort, 此刻本段尚未写任何文件。
  Call QimuEnsureClosed
  SetOutPath "$INSTDIR"
  ; X13(修订): File 指令不接受 /REBOOTOK (makensis 会把它当文件名,
  ; 2026-11-25 构建实证), 锁住 exe 的重启替换本轮撤下, 待用
  ; File→临时名 + Rename /REBOOTOK 的标准写法单独验证后再上
  File "win/qimu-client.exe"
  File "win/qimu.exe"
  ; X8: 清理旧捆绑包遗留的 deckcraft.exe —— 它会遮蔽用户另行安装的
  ; DeckCraft (客户端按 exe 同级优先解析), 本包早已不再捆绑它
  Delete "$INSTDIR\deckcraft.exe"
  File "win/使用说明.txt"
  File "win/qimu.ico"
  ; 离线缓存目录预建 (客户端默认 cache 路径 = 安装目录\cache)
  CreateDirectory "$INSTDIR\cache"
  ; 快捷方式: 桌面 + 开始菜单
  CreateShortcut "$DESKTOP\启幕.lnk" "$INSTDIR\qimu-client.exe" "" "$INSTDIR\qimu.ico"
  CreateDirectory "$SMPROGRAMS\启幕"
  CreateShortcut "$SMPROGRAMS\启幕\启幕.lnk" "$INSTDIR\qimu-client.exe" "" "$INSTDIR\qimu.ico"
  CreateShortcut "$SMPROGRAMS\启幕\使用说明.lnk" "$INSTDIR\使用说明.txt"
  ; 卸载登记 (独立于服务器包的 QimuServer 项)
  WriteUninstaller "$INSTDIR\uninstall.exe"
  WriteRegStr HKLM "Software\QimuClient" "InstallDir" "$INSTDIR"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\QimuClient" "DisplayName" "${PRODUCT}"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\QimuClient" "Publisher" "${PUBLISHER}"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\QimuClient" "DisplayVersion" "${VERSION}"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\QimuClient" "DisplayIcon" "$INSTDIR\qimu.ico"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\QimuClient" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\QimuClient" "UninstallString" "$INSTDIR\uninstall.exe"
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\QimuClient" "NoModify" 1
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\QimuClient" "NoRepair" 1
SectionEnd

Section "Uninstall"
  Delete "$DESKTOP\启幕.lnk"
  Delete "$SMPROGRAMS\启幕\启幕.lnk"
  Delete "$SMPROGRAMS\启幕\使用说明.lnk"
  RMDir "$SMPROGRAMS\启幕"
  Delete /REBOOTOK "$INSTDIR\qimu-client.exe"
  Delete /REBOOTOK "$INSTDIR\qimu.exe"
  Delete "$INSTDIR\deckcraft.exe"
  Delete "$INSTDIR\使用说明.txt"
  Delete "$INSTDIR\qimu.ico"
  RMDir /r "$INSTDIR\fonts"
  Delete "$INSTDIR\uninstall.exe"
  ; 离线缓存可重建, 直接清掉
  RMDir /r "$INSTDIR\cache"
  RMDir "$INSTDIR"
  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\QimuClient"
  DeleteRegKey HKLM "Software\QimuClient"
SectionEnd
